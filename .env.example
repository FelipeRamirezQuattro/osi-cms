# Supabase (MVP database only — see CLAUDE.md, constraint 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy media host — see lib/media.ts (constraint 3)
NEXT_PUBLIC_LEGACY_MEDIA_BASE=https://static.wixstatic.com

# Public site URL, used for metadata/OG/sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form notification email (Resend) — see lib/email.ts. Optional:
# the form and its admin inbox work without these, they just gate the
# outbound notification email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
# Any random string — salts the contact form's IP-based rate-limit hash.
IP_HASH_SALT=

# Google Search Console (Visitors Dashboard SEO reports) — a service
# account granted delegated read access to the site's GSC property via
# Search Console's own "Users and permissions" UI. See
# lib/data/seo-search-console.ts and scripts/verify-gsc-connection.ts.
GSC_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM private key with literal \n escapes for newlines.
GSC_SERVICE_ACCOUNT_PRIVATE_KEY=
GSC_SITE_URL=

# Newsletter (Phase 9). Any long random string (e.g. `openssl rand -base64 48`).
# Signs the confirm/unsubscribe links in newsletter emails — see
# lib/newsletter/tokens.ts. REQUIRED for newsletter signup to work; without it
# signup is disabled. Changing it invalidates every link already emailed.
NEWSLETTER_TOKEN_SECRET=
# Physical mailing address printed in every newsletter's footer (CAN-SPAM
# requires one in commercial email). REQUIRED before a campaign can be sent to
# subscribers; test emails work without it. The client must supply the real
# address — see docs/CONTENT-GAPS.md.
NEWSLETTER_MAILING_ADDRESS=
