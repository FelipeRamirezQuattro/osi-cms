# Supabase (MVP database only — see CLAUDE.md, constraint 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy media host — see lib/media.ts (constraint 3)
NEXT_PUBLIC_LEGACY_MEDIA_BASE=https://static.wixstatic.com

# Public site URL, used for metadata/OG/sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form notification email (Resend) — see lib/email.ts. Optional:
# the form and its admin inbox work without these, they just gate the
# outbound notification email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
# Any random string — salts the contact form's IP-based rate-limit hash.
IP_HASH_SALT=
